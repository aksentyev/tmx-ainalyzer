// Диффузионный колпак над электрохимическим сенсором ZE07-CO.
// Плата ZE07 (25.4 × 22.4) лишь на ~1.2 мм шире сенсора Ø20, выводы торчат вниз — фланцу
// места нет. Стакан надевается на цилиндр сенсора с зазором 0.3 на сторону, кромка не доходит
// до платы на 2 мм; уплотнение — валик нейтрального RTV по кромке стакана на тело сенсора.
// Две ёлочки навстречу друг другу над верхом сенсора — газ обтекает мембрану без прямой струи.
// Смоделирован ЗАКРЫТЫМ ТОРЦОМ ВНИЗ (z=0) — так и печатать: без мостов и нависаний.
include <params.scad>
use <lib.scad>

in_d   = ec_d + ec_cup_gap;
in_h   = (ec_h - ec_rim_above_pcb) + ec_headroom;      // глубина стакана
od     = in_d + 2 * wall;
barb_z = wall + ec_headroom / 2;                        // над сенсором, у закрытого торца

module ze07_cap() {
    difference() {
        union() {
            cylinder(d = od, h = in_h + wall);
            for (s = [-1, 1]) translate([0, s * (od / 2 - 0.5), barb_z]) rotate([-s * 90, 0, 0]) barb();
        }
        translate([0, 0, wall]) cylinder(d = in_d, h = in_h + 1);
        for (s = [-1, 1]) translate([0, s * (in_d / 2 - 1), barb_z]) rotate([-s * 90, 0, 0]) cylinder(d = barb_id, h = wall + 3);
    }
}

ze07_cap();
