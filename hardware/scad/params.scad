// Общие параметры печатных деталей. Все размеры в мм.
// Пометка ИЗМЕРИТЬ — значение из даташита/оценка, поправить по реальной детали перед печатью.

$fn = 96;

// ---------- трубка и пробки ----------
bore_d             = 22.0;   // ИЗМЕРИТЬ: внутренний Ø алюминиевой трубки (два замера, среднее)
plug_fits          = [0.0, 0.2, 0.4];  // варианты зазора по диаметру для тест-колец и пробок
plug_fit           = 0.2;    // зазор по умолчанию (пробка Ø = bore_d - plug_fit)
plug_depth         = 15;     // глубина вставной части (задаёт L_ак = L_трубы - 2*plug_depth)
flange_d           = 30;     // фланец, упирается в торец трубки
flange_t           = 10;     // толщина фланца — в нём каналы и карманы

// O-ring 18×2, радиальное уплотнение в канале Ø22
oring_cs           = 2.0;
oring_groove_w     = 2.7;
oring_groove_depth = 1.6;    // +0.1 к номиналу — слои дают шероховатость
oring_z            = 8;      // центр канавки от внутреннего торца пробки

// ---------- пробка A: динамик ----------
spk_d              = 20.2;   // ИЗМЕРИТЬ: Ø динамика
spk_boss_h         = 1.5;    // зазор между задней стенкой динамика и пробкой (газ идёт здесь)
spk_boss_d         = 3;
spk_boss_r         = 8.5;    // радиус расположения бобышек — на кольцо корзины динамика
rear_cav_d         = 14;     // задняя камера (не больше: до дна канавки O-ring должно остаться ≥2 мм)
rear_cav_h         = 10;
lug_w_a            = 14;
lug_len_a          = 15;     // выступ лага с портом за край фланца

// ---------- пробка B: микрофон + TMP117 + выход ----------
mic_pcb            = [10.5, 10.5, 1.2];  // ИЗМЕРИТЬ: плата микрофона (ICS-43434 брейкаут; INMP441 = 14×11 — не влезет, см. README)
mic_recess_depth   = 2.6;    // плата + компоненты со стороны пробки
tmp_pcb            = [15.0, 12.0, 1.6];  // ИЗМЕРИТЬ: плата TMP117
lug_w_b            = 20;
lug_len_b          = 22;

// ---------- порты ----------
barb_od            = 6.0;    // ёлочка под силикон 4×6
barb_id            = 2.5;
barb_len           = 10;
chan_d             = 3.0;    // внутренние газовые каналы

// ---------- камера O2-ячейки ----------
cell_d             = 32.2;   // ИЗМЕРИТЬ: Ø тела ячейки (R-22D / PSR-11-39-MD ≈ 32)
cell_h             = 24.0;   // ИЗМЕРИТЬ: высота тела от плеча носика до задней плоскости (без Molex)
nose_d             = 16.2;   // ИЗМЕРИТЬ: Ø носика (резьба M16×1 → 16)
molex_slot         = [12, 9]; // ИЗМЕРИТЬ: вырез в крышке под разъём ячейки
o2_chamber_d       = 16;
o2_chamber_h       = 10;     // ≈2 мл перед мембраной
o2_face_oring_id   = 20;     // O-ring 20×2, торцевое уплотнение по плечу ячейки
o2_face_oring_cs   = 2.0;
bmp_pcb            = [15.5, 12.5, 1.6];  // ИЗМЕРИТЬ: плата BMP390

// ---------- колпак SCD30 ----------
scd_dims           = [35.2, 23.2, 7.2];  // ИЗМЕРИТЬ: габарит модуля SCD30 (≈35×23×7)

// ---------- колпак ZE07 ----------
ec_d               = 20.4;   // ИЗМЕРИТЬ: Ø электрохимического сенсора на плате ZE07
ec_h               = 17.0;   // ИЗМЕРИТЬ: высота сенсора над платой

// ---------- печать ----------
wall               = 2.0;    // стенка колпаков
clr                = 0.4;    // зазор на посадку плат в карманы (по диаметру/стороне)
