// Общие параметры печатных деталей. Все размеры в мм.
// Пометка ИЗМЕРИТЬ — значение из даташита/оценка, поправить по реальной детали перед печатью.

$fn = 96;

// ---------- трубка и пробки ----------
bore_d             = 22.0;   // ИЗМЕРИТЬ: внутренний Ø алюминиевой трубки (два замера, среднее)
plug_fits          = [0.2, 0.4, 0.6];  // варианты зазора по Ø для тест-колец и пробок (0.0 не войдёт: PETG растёт на +0.1..0.2)
plug_fit           = 0.2;    // зазор по умолчанию (пробка Ø = bore_d - plug_fit)
plug_depth         = 15;     // глубина вставной части (L_ак ≈ L_трубы - 2*plug_depth - вылет динамика)
flange_d           = 30;     // фланец, упирается в торец трубки
flange_t           = 10;     // толщина фланца — в нём каналы и карманы
lead_chamfer       = 0.5;    // фаска на ведущей кромке пробок и колец

// O-ring 18×2, радиальное уплотнение в канале Ø22.
// Дно канавки задаётся от КАНАЛА, а не от пробки: обжатие 20 % при любом fit.
oring_cs           = 2.0;
oring_groove_w     = 2.7;                        // 1.35·cs
oring_squeeze      = 0.20;                       // целевое обжатие
groove_bottom_d    = bore_d - 2 * (1 - oring_squeeze) * oring_cs;   // 18.8 при канале 22
oring_z            = 8;      // центр канавки от внутреннего торца пробки
oring_chamfer      = 0.8;    // фаска 45° на стенке канавки, которая нависает при печати

// ---------- пробка A: динамик ----------
spk_d              = 20.2;   // ИЗМЕРИТЬ: Ø динамика
spk_h              = 3.0;    // ИЗМЕРИТЬ: высота динамика (влияет на L_ак)
spk_boss_h         = 1.5;    // зазор между задней стенкой динамика и пробкой (газ идёт здесь)
spk_boss_d         = 3;
spk_boss_r         = 8.5;    // радиус бобышек — на кольцо корзины (r ≈ 8.1–10.1 у типовых 20 мм)
rear_cav_d         = 14;     // задняя камера: до дна канавки O-ring остаётся 2.4 мм
rear_cav_h         = 10;
chan_y_a           = -5;     // ось осевого газового канала пробки A
wire_y_a           = 5;      // ось отверстия под провода динамика
spk_wire_d         = 3.0;    // две жилы 30 AWG
lug_w_a            = 14;
lug_len_a          = 15;     // выступ лага с ёлочкой за край фланца

// ---------- пробка B: микрофон + TMP117 + выход ----------
mic_pcb            = [10.5, 10.5, 1.2];  // ИЗМЕРИТЬ: плата микрофона (ICS-43434 брейкаут; INMP441 14×11 — не влезет)
mic_recess_depth   = 3.5;    // плата 1.2 + компоненты ~1.2 + пайки
mic_wire_d         = 3.5;    // пять жил 30 AWG (пучок ≈3.2)
mic_wire_pos       = [4.5, 0];   // центр отверстия: 2.7 мм внутри углубления, до дна канавки 3.15
out_y_b            = -6.2;   // ось осевого выходного канала (0.5 от углубления, 1.85 до канавки)
out_d_b            = 2.5;
tmp_pcb            = [15.0, 12.0, 1.6];  // ИЗМЕРИТЬ: плата TMP117 (Adafruit 25×18 не влезет)
tmp_pocket_depth   = 6;      // карман = газовая камера: плата на дне, каналы над ней, сверху крышка
tmp_cover_t        = 1.5;    // приклеиваемая крышка кармана
lug_w_b            = 20;
lug_len_b          = 22;

// ---------- порты ----------
barb_od            = 5.4;    // гребень ёлочки под силикон ID 4 (1.35×)
barb_id            = 2.2;    // стенка шейки ≥1.2 мм
barb_len           = 10;
chan_d             = 3.0;    // внутренние газовые каналы

// ---------- камера O2-ячейки ----------
cell_d             = 32.2;   // ИЗМЕРИТЬ: Ø тела ячейки (R-22D / PSR-11-39-MD ≈ 32)
cell_h             = 24.0;   // ИЗМЕРИТЬ: высота тела от плеча носика до задней плоскости (без Molex)
nose_d             = 16.0;   // ИЗМЕРИТЬ: Ø носика (резьба M16×1)
nose_len           = 6.0;    // ИЗМЕРИТЬ: длина носика от плеча до мембраны
nose_clr           = 0.6;    // печатные отверстия уходят в минус на 0.2–0.3
molex_slot         = [12, 9]; // ИЗМЕРИТЬ: вырез в крышке под разъём ячейки
o2_chamber_h       = 10;     // камера под носиком, Ø = Ø отверстия носика (уступа нет)
o2_face_oring_id   = 21;     // O-ring 21×2, торцевое уплотнение по плечу ячейки; губа до носика 2.0
o2_face_oring_cs   = 2.0;
cell_press         = 1.2;    // ячейка выступает над бортиком стакана — крышка её дожимает
bmp_pcb            = [15.5, 12.5, 1.6];  // ИЗМЕРИТЬ: плата BMP390

// ---------- колпак SCD30 ----------
scd_dims           = [35.2, 23.2, 7.2];  // ИЗМЕРИТЬ: модуль SCD30 (даташит 35×23×7, плата 1.6)
scd_pin_len        = 3.5;    // выводы торчат ВНИЗ (если гребёнка впаяна); отверстия CO2/RH — тоже снизу
scd_pins_w         = 16;     // ряд 7 пинов × 2.54 вдоль ДЛИННОЙ кромки

// ---------- колпак ZE07 ----------
ec_d               = 20.0;   // даташит: EC-сенсор Ø20 × 16.7 на плате 25.4 × 22.4
ec_h               = 16.7;
ec_pcb             = [25.4, 22.4];   // для справки: вокруг сенсора ~1.2 мм платы, фланцу места нет
ec_cup_gap         = 0.6;    // зазор стакан–сенсор по Ø (уплотнение валиком RTV по кромке)
ec_rim_above_pcb   = 2.0;    // кромка стакана не доходит до платы
ec_headroom        = 3.0;    // над сенсором

// ---------- печать ----------
wall               = 2.0;    // стенка колпаков
clr                = 0.4;    // зазор на посадку плат в карманы (по стороне)
